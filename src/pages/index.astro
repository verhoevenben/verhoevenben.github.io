---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { copy } from '../i18n/copy';
import heroPhoto from '../assets/BenVerhoeven-By-Fredography-Full-73.jpg';
import coachingPhoto from '../assets/COACHING_BEN_005.jpg';
import presentingPhoto from '../assets/231214-KULeuven-3MT-008.jpg';
import theatrePhoto from '../assets/koninkrijk deer weetgierigen_maruszak.photo_S-36.JPG';
import improvPhoto from '../assets/2023-12-17 Kemphanen 2023 Finale 675.jpg';
import teachingPhoto from '../assets/_MG_6901.jpg';

const { nl, en } = copy;

const portfolioPhotos = [theatrePhoto, coachingPhoto, presentingPhoto, improvPhoto, teachingPhoto];

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 10);
const newsHues = [35, 190, 90, 340, 250, 10, 160, 280, 60, 220, 300];

function stripeStyle(hue: number) {
	return `background-image: repeating-linear-gradient(135deg, oklch(88% 0.05 ${hue}) 0, oklch(88% 0.05 ${hue}) 14px, oklch(93% 0.03 ${hue}) 14px, oklch(93% 0.03 ${hue}) 28px);`;
}

function newsStripeStyle(hue: number) {
	return `background-image: repeating-linear-gradient(135deg, oklch(90% 0.03 ${hue}) 0, oklch(90% 0.03 ${hue}) 14px, oklch(94% 0.01 240) 14px, oklch(94% 0.01 240) 28px);`;
}
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<!-- HERO -->
	<div class="hero">
		<div>
			<div class="hero-kicker">
				<span class="lang-nl">{nl.hero.kicker}</span><span class="lang-en">{en.hero.kicker}</span>
			</div>
			<h1 class="hero-title">{nl.hero.title}</h1>
			<p class="hero-sub">
				<span class="lang-nl">{nl.hero.sub}</span><span class="lang-en">{en.hero.sub}</span>
			</p>
			<div class="hero-cta-row">
				<a href="/training" class="btn btn-primary">
					<span class="lang-nl">{nl.hero.ctaTraining}</span><span class="lang-en"
						>{en.hero.ctaTraining}</span
					>
				</a>
				<a href="#contact" class="btn btn-outline">
					<span class="lang-nl">{nl.hero.ctaContact}</span><span class="lang-en"
						>{en.hero.ctaContact}</span
					>
				</a>
			</div>
		</div>
		<div class="hero-photo">
			<Image src={heroPhoto} alt="Ben Verhoeven" width={800} />
		</div>
	</div>

	<!-- PORTFOLIO GRID -->
	<div class="section section-alt">
		<div class="section-inner">
			<h2 class="section-heading">
				<span class="lang-nl">{nl.portfolioHeading}</span><span class="lang-en"
					>{en.portfolioHeading}</span
				>
			</h2>
			<div class="card-grid">
				{
					nl.portfolioItems.map((item, i) => {
						const enItem = en.portfolioItems[i];
						const photo = portfolioPhotos[i];
						const Tag = item.href ? 'a' : 'div';
						const linkProps = item.href
							? item.external
								? { href: item.href, target: '_blank', rel: 'noopener noreferrer' }
								: { href: item.href }
							: {};
						return (
							<Tag class="card" {...linkProps}>
								<div class="card-image" style={photo ? undefined : stripeStyle(item.hue)}>
									{photo && <Image src={photo} alt="" width={600} />}
									{!photo && (
										<span class="card-image-label">
											<span class="lang-nl">{item.photoLabel}</span>
											<span class="lang-en">{enItem.photoLabel}</span>
										</span>
									)}
								</div>
								<div class="card-body">
									<div class="card-tag" style={`color: ${item.accent}`}>
										<span class="lang-nl">{item.tag}</span>
										<span class="lang-en">{enItem.tag}</span>
									</div>
									<div class="card-title">
										<span class="lang-nl">{item.title}</span>
										<span class="lang-en">{enItem.title}</span>
									</div>
									<div class="card-desc">
										<span class="lang-nl">{item.desc}</span>
										<span class="lang-en">{enItem.desc}</span>
									</div>
								</div>
							</Tag>
						);
					})
				}
			</div>
		</div>
	</div>

	<!-- NEWS -->
	<div class="section">
		<div class="section-inner">
			<h2 class="section-heading">
				<span class="lang-nl">{nl.newsHeading}</span><span class="lang-en">{en.newsHeading}</span>
			</h2>
			<div class="news-grid">
				{
					posts.map((post, i) => (
						<a href={`/updates/${post.id}/`} class="news-tile" aria-label={post.data.title.nl}>
							<div
								class="news-tile-photo"
								style={post.data.heroImage ? undefined : newsStripeStyle(newsHues[i % newsHues.length])}
							>
								{post.data.heroImage && <Image src={post.data.heroImage} alt="" width={400} />}
							</div>
							<div class="news-tile-title">
								<span class="lang-nl">{post.data.title.nl}</span>
								<span class="lang-en">{post.data.title.en}</span>
							</div>
						</a>
					))
				}
			</div>
			<div class="news-more">
				<a href="/updates" class="btn btn-outline">
					<span class="lang-nl">{nl.newsMoreButton}</span><span class="lang-en"
						>{en.newsMoreButton}</span
					>
				</a>
			</div>
		</div>
	</div>

	<!-- CONTACT -->
	<div id="contact" class="dark-section">
		<div class="dark-section-inner">
			<h2>
				<span class="lang-nl">{nl.contact.heading}</span><span class="lang-en"
					>{en.contact.heading}</span
				>
			</h2>
			<p>
				<span class="lang-nl">{nl.contact.text}</span><span class="lang-en">{en.contact.text}</span
				>
			</p>
			<div class="dark-links">
				<a href="mailto:ben@erlnmyr.be">ben@erlnmyr.be</a>
				<a href="tel:+32497552165">+32 497 55 21 65</a>
			</div>
		</div>
	</div>
</PageLayout>
