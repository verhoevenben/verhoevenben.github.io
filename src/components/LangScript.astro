<script is:inline>
	(function () {
		function detect() {
			try {
				var saved = localStorage.getItem('lang');
				if (saved === 'nl' || saved === 'en') return saved;
			} catch (e) {}
			var nav = (navigator.language || 'nl').toLowerCase();
			return nav.startsWith('nl') ? 'nl' : 'en';
		}
		function syncLinks(lang) {
			document.querySelectorAll('[data-href-nl]').forEach(function (el) {
				var href = lang === 'en' ? el.getAttribute('data-href-en') : el.getAttribute('data-href-nl');
				if (href) el.setAttribute('href', href);
			});
		}
		var lang = detect();
		document.documentElement.setAttribute('data-lang', lang);
		document.documentElement.setAttribute('lang', lang);
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', function () {
				syncLinks(lang);
			});
		} else {
			syncLinks(lang);
		}

		window.setLang = function (lang) {
			document.documentElement.setAttribute('data-lang', lang);
			document.documentElement.setAttribute('lang', lang);
			syncLinks(lang);
			try {
				localStorage.setItem('lang', lang);
			} catch (e) {}
		};
	})();
</script>
