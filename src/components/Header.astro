---
import { copy } from '../i18n/copy';

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const isHome = pathname === '/' || pathname === '';
const isTraining = pathname.startsWith('/training');
const isUpdates = pathname.startsWith('/updates');
---

<header class="site-nav">
	<div class="site-nav-inner">
		<a href="/" class="logo">Ben Verhoeven</a>
		<nav class="nav-links">
			<a href="/" class:list={['nav-link', { active: isHome }]}>
				<span class="lang-nl">{copy.nl.nav.home}</span><span class="lang-en">{copy.en.nav.home}</span>
			</a>
			<a href="/training" class:list={['nav-link', { active: isTraining }]}>
				<span class="lang-nl">{copy.nl.nav.training}</span><span class="lang-en"
					>{copy.en.nav.training}</span
				>
			</a>
			<a href="/updates" class:list={['nav-link', { active: isUpdates }]}>
				<span class="lang-nl">{copy.nl.nav.blog}</span><span class="lang-en">{copy.en.nav.blog}</span>
			</a>
			<div class="nav-divider" aria-hidden="true"></div>
			<div class="lang-toggle" role="group" aria-label="Language">
				<button type="button" class="lang-btn" data-lang-btn="nl" onclick="setLang('nl')"
					>NL</button
				>
				<button type="button" class="lang-btn" data-lang-btn="en" onclick="setLang('en')"
					>EN</button
				>
			</div>
		</nav>
	</div>
</header>
